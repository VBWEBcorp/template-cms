# Copier en .env.local (développement) et reporter les mêmes clés dans les
# variables d'environnement de l'hébergeur (production). Ne jamais committer
# de vraie valeur.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Adresse publique, sans barre finale. Sert aux canonical, au sitemap, aux
# données structurées et aux e-mails. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
# Nom de la marque (sinon celui de src/config/site.ts)
NEXT_PUBLIC_SITE_NAME=
# Lien de prise de rendez-vous (Calendly, Cal.com...). Vide : formulaire seul.
NEXT_PUBLIC_APPOINTMENT_URL=
# 1 : bandeau rouge « maquette de démonstration » en pied de page
NEXT_PUBLIC_DEMO_BANNER=

# ---------------------------------------------------------------------------
# Base de données (facultative : sans elle, le site affiche le contenu du code)
# ---------------------------------------------------------------------------
# En local, une base locale : mongodb://localhost:27017/nom-du-site
# Jamais la base de production depuis un poste de développement.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Espace admin
# ---------------------------------------------------------------------------
# Compte du client (connexion sans base de données)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Secret de signature des sessions, obligatoire en production :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# E-mails (Resend) : formulaire de contact, newsletter
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Expéditeur sur le domaine du client, VALIDÉ dans Resend. Une adresse
# @resend.dev est refusée (elle n'écrit qu'au titulaire du compte Resend).
EMAIL_FROM="Nom du site <contact@exemple.fr>"
# Destinataires des messages du formulaire, séparés par des virgules
# (sinon l'e-mail de la page Contact)
CONTACT_TO=

# ---------------------------------------------------------------------------
# PHARE (outil SEO de l'agence) : dépôt des articles et de llms.txt
# ---------------------------------------------------------------------------
# Secret propre à ce site, identique à celui saisi dans la fiche PHARE du client
PHARE_WEBHOOK_SECRET=
# Facultatif sur Netlify : vide le cache CDN après une publication
NETLIFY_PURGE_API_TOKEN=

# ---------------------------------------------------------------------------
# Images envoyées depuis l'admin (Cloudflare R2). Sans elles : public/uploads
# (ne fonctionne qu'en local, le disque d'un hébergement serverless est en lecture seule)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Adresse publique du bucket (domaine personnalisé ou https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# IndexNow (Bing, Yandex) : soumission immédiate des articles. Clé libre de
# 8 à 128 caractères, servie sur /indexnow-key.txt
# ---------------------------------------------------------------------------
INDEXNOW_KEY=
